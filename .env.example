# Copy to .env (PowerShell: Copy-Item .env.example .env) and edit. NEVER commit .env.

# --- MongoDB (source) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=schemashift_demo
MONGO_COLLECTIONS=customers,products,orders

# --- PostgreSQL (target) ---
# Use the password you chose when you installed PostgreSQL. If it contains special characters
# (@ : / # %), URL-encode them (e.g. @ -> %40).
POSTGRES_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/schemashift_target
# Dedicated schema for ALL migrated tables; rollback only ever touches tables of this schema.
TARGET_SCHEMA=schemashift_demo

# --- Matching / migration ---
SIMILARITY_THRESHOLD=0.75
BATCH_SIZE=500
SAMPLE_SIZE=1000
SAMPLE_SEED=42

# --- AI (optional). mock = offline deterministic helper (NOT an LLM) ---
# To use real OpenAI: set AI_PROVIDER=openai and add your API key.
# Requires an OpenAI account with billing enabled and available API credits.
# The Responses API (used by SchemaShift) requires openai>=1.66.0.
# NEVER commit your API key. Enter it only in your local .env file.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

# --- Safety ---
# Must be true for `python -m app.cli rollback` to drop the demo tables.
ALLOW_DESTRUCTIVE_CLEANUP=false

# --- Optional: persist LangGraph state in SQLite so an interrupted approval can be resumed later ---
CHECKPOINT_DB=
